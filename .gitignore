# Dependencies
node_modules/

# Build output
app/.next/
app/out/
release/
*.tsbuildinfo

# Database (local state, not committed)
db/*.db
db/*.db-journal

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.output/
.env

# Local database backups / temp writes
db/backups/
db/*.db.tmp

# Real (non-demo) source files must never be committed
imports/
*.real.xlsx
*.real.docx
dist/

# Rosters generated from (de-identified) real exports — never commit
demo-data/from-export/
